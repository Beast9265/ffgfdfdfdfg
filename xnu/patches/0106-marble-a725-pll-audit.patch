+/* Read-only Cape Lucid-OLE register audit; never acquire a PLL or rail. */
+struct a725_pll_sample {
+	uint32_t mode, opmode, status, l, alpha, user, vote, gpu_vote;
+};
+
+static void
+a725_pll_sample(vm_offset_t gcc, uint32_t base, struct a725_pll_sample *s)
+{
+	s->mode = a725_read32(gcc, base + A725_GPLL0_MODE);
+	s->opmode = a725_read32(gcc, base + A725_GPLL0_OPMODE);
+	s->status = a725_read32(gcc, base + 0x0c); /* PLL_OFF_STATUS */
+	s->l = a725_read32(gcc, base + A725_GPLL0_L);
+	s->alpha = a725_read32(gcc, base + A725_GPLL0_ALPHA);
+	s->user = a725_read32(gcc, base + A725_GPLL0_USER);
+	s->vote = a725_read32(gcc, A725_GPLL0_VOTE);
+	s->gpu_vote = a725_read32(gcc, A725_GPU_GPLL0_VOTES);
+}
+
+/* Same strict prerequisites as 0105, expressed separately for diagnosis.
+ * This function only explains refusal; it cannot authorize clock writes. */
+static uint32_t
+a725_pll_refusal(const struct a725_pll_sample *s)
+{
+	uint32_t reason = 0;
+	if (!(s->mode & (1u << 31))) reason |= 1u;
+	if (!(s->mode & 1u)) reason |= 2u;
+	if (s->opmode != 1u) reason |= 4u;
+	if ((s->l & 0xffffu) != 31u ||
+	    (s->alpha & 0xffffu) != 0x4000u) reason |= 8u;
+	if (((s->user >> 10) & 0xfu) != 1u) reason |= 16u;
+	return reason;
+}
+
+static void
+a725_pll_readonly_test(vm_offset_t gcc, boolean_t visual)
+{
+	struct a725_pll_sample samples[2][2];
+	for (unsigned pass = 0; pass < 2; pass++) {
+		a725_pll_sample(gcc, 0, &samples[pass][0]);
+		a725_pll_sample(gcc, 0x4000, &samples[pass][1]);
+		if (pass == 0) delay(1000);
+	}
+	printf("\n============================================================\n");
+	printf(" MARBLE GPLL READ-ONLY AUDIT a725-pll-audit-v1\n");
+	printf(" GCC PA=%08x; 2 samples, 1000us apart\n", A725_GCC_PA);
+	for (unsigned pass = 0; pass < 2; pass++) {
+		for (unsigned pll = 0; pll < 2; pll++) {
+			const struct a725_pll_sample *s = &samples[pass][pll];
+			printf(" S%u GPLL%u MODE=%08x OP=%08x STATUS=%08x\n",
+			    pass, pll * 4, s->mode, s->opmode, s->status);
+			printf("  L=%08x ALPHA=%08x USER=%08x\n",
+			    s->l, s->alpha, s->user);
+			printf("  LOCK=%u OUT=%u RESET_N=%u VOTE_RUN=%u\n",
+			    !!(s->mode & (1u << 31)), !!(s->mode & 1u),
+			    !!(s->mode & 4u), !!(s->user & (1u << 25)));
+			printf("  APSS_VOTE=%08x GPU_GATES=%08x\n", s->vote, s->gpu_vote);
+		}
+	}
+	uint32_t reason = a725_pll_refusal(&samples[1][0]);
+	printf(" GPLL0 REFUSAL=%02x (01 lock 02 output 04 run)\n", reason);
+	printf("                       (08 rate 10 divider)\n");
+	printf(" GPLL0 REGISTER-DECODE Hz=%llu; expected 600000000\n",
+	    (unsigned long long)((uint64_t)(samples[1][0].l & 0xffffu) * 19200000u +
+	    (((uint64_t)(samples[1][0].alpha & 0xffffu) * 19200000u) >> 16)));
+	printf(" Register decode is NOT a measured clock frequency.\n");
+	printf(" CAPTURE COMPLETE; PLL/GPU EXECUTION NOT TESTED\n");
+	printf(" NO MMIO WRITES / NO RAIL VOTES / NO ROOT ACCESS\n");
+	printf("============================================================\n");
+	if (visual) delay(10000000);
+}
+
