+static void
+a725_qmp_kick(const struct marble_a725_resources *r)
+{
+	/* Cape assigns both IPCC_CLIENT_AOP and GLINK_QMP signal ID zero. */
+	a725_write32(r->ipcc, A725_IPCC_SEND_ID, 0);
+}
+
+static void
+a725_qmp_close(const struct marble_a725_resources *r)
+{
+	a725_write32(r->aoss, A725_QMP_M_CH, A725_QMP_STATE_DOWN);
+	a725_write32(r->aoss, A725_QMP_M_LINK, A725_QMP_STATE_DOWN);
+	a725_qmp_kick(r);
+}
