+/*
+ * Send the exact Gen7 KGSL ACD request over Cape's AOSS QMP mailbox.  The
+ * Linux driver uses one-second bounds for each link/channel/message ACK; poll
+ * the same shared-memory state so this early diagnostic needs no IRQ handler.
+ */
+static int
+a725_aop_acd_enable(const struct marble_a725_resources *r)
+{
+	static const uint32_t message[] = {
+		0x616c637bu, 0x203a7373u, 0x2c757067u, 0x73657220u,
+		0x6361203au, 0x76202c64u, 0x203a6c61u, 0x00007d31u,
+	}; /* "{class: gpu, res: acd, val: 1}" plus NUL, 4-byte aligned */
+	uint32_t offset, size;
+
+	if (a725_read32(r->aoss, 0) != A725_QMP_MAGIC ||
+	    a725_read32(r->aoss, 4) != A725_QMP_VERSION) {
+		return ENXIO;
+	}
+	offset = a725_read32(r->aoss, A725_QMP_M_OFFSET);
+	size = a725_read32(r->aoss, A725_QMP_M_SIZE);
+	if (offset > A725_AOSS_SIZE || size < sizeof(message) + 4 ||
+	    size > A725_AOSS_SIZE - offset) {
+		return EINVAL;
+	}
+
+	/* Acknowledge AOP's link, then bring up the AP link and channel. */
+	a725_write32(r->aoss, A725_QMP_U_LINK_ACK,
+	    a725_read32(r->aoss, A725_QMP_U_LINK));
+	a725_write32(r->aoss, A725_QMP_M_LINK, A725_QMP_STATE_UP);
+	a725_qmp_kick(r);
+	if (!a725_poll32(r->aoss, A725_QMP_M_LINK_ACK, 0xffffffffu,
+	    A725_QMP_STATE_UP, 1000000)) {
+		a725_qmp_close(r);
+		return ETIMEDOUT;
+	}
+
+	a725_write32(r->aoss, A725_QMP_M_CH, A725_QMP_STATE_UP);
+	a725_qmp_kick(r);
+	if (!a725_poll32(r->aoss, A725_QMP_U_CH, 0xffffffffu,
+	    A725_QMP_STATE_UP, 1000000)) {
+		a725_qmp_close(r);
+		return ETIMEDOUT;
+	}
+	a725_write32(r->aoss, A725_QMP_U_CH_ACK, A725_QMP_STATE_UP);
+	a725_qmp_kick(r);
+	if (!a725_poll32(r->aoss, A725_QMP_M_CH_ACK, 0xffffffffu,
+	    A725_QMP_STATE_UP, 1000000)) {
+		a725_qmp_close(r);
+		return ETIMEDOUT;
+	}
+
+	for (unsigned i = 0; i < sizeof(message) / sizeof(message[0]); i++) {
+		a725_write32(r->aoss, offset + 4 + i * 4, message[i]);
+	}
+	a725_write32(r->aoss, offset, sizeof(message));
+	a725_qmp_kick(r);
+	if (!a725_poll32(r->aoss, offset, 0xffffffffu, 0, 1000000)) {
+		a725_write32(r->aoss, offset, 0);
+		a725_qmp_close(r);
+		return ETIMEDOUT;
+	}
+	a725_qmp_close(r);
+	return 0;
+}
