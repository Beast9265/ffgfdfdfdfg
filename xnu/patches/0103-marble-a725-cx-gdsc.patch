+/*
+ * Mirror Cape's qcom,gdsc regulator contract: reject HW-control ownership,
+ * program only the DT-specified CLK_DIS_WAIT field, clear SW_COLLAPSE, and
+ * poll the separate hw-ctrl status register for at most 2 x 500 us.  Restore
+ * the original collapsed register before releasing CX/MX votes.
+ */
+static int
+a725_cx_enable_test(const struct marble_a725_resources *r,
+    struct a725_power_results *result)
+{
+	uint32_t value;
+
+	result->cx_gdscr_before = a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+	if (!a725_valid_read(result->cx_gdscr_before) ||
+	    !(result->cx_gdscr_before & A725_GDSC_SW_COLLAPSE) ||
+	    (result->cx_gdscr_before & A725_GDSC_HW_CONTROL)) {
+		return EBUSY;
+	}
+	value = result->cx_gdscr_before;
+	value &= ~(A725_GDSC_HW_CONTROL | A725_GDSC_SW_OVERRIDE |
+	    A725_GDSC_CLK_DIS_WAIT_MASK);
+	value |= A725_GDSC_CLK_DIS_WAIT_CAPE;
+	result->cx_touched = TRUE;
+	a725_write32(r->gpucc, A725_GPUCC_CX_GDSCR, value);
+	if ((a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR) &
+	    (A725_GDSC_HW_CONTROL | A725_GDSC_SW_OVERRIDE |
+	    A725_GDSC_CLK_DIS_WAIT_MASK)) != (value &
+	    (A725_GDSC_HW_CONTROL | A725_GDSC_SW_OVERRIDE |
+	    A725_GDSC_CLK_DIS_WAIT_MASK))) {
+		return EIO;
+	}
+
+	value &= ~A725_GDSC_SW_COLLAPSE;
+	a725_write32(r->gpucc, A725_GPUCC_CX_GDSCR, value);
+	(void)a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+	delay(1); /* downstream requires eight XO cycles before status polling */
+	if (!a725_poll32(r->gpucc, A725_GPUCC_CX_HWCTRL,
+	    A725_GDSC_PWR_ON, A725_GDSC_PWR_ON, 500) &&
+	    !a725_poll32(r->gpucc, A725_GPUCC_CX_HWCTRL,
+	    A725_GDSC_PWR_ON, A725_GDSC_PWR_ON, 500)) {
+		result->cx_gdscr_on = a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+		result->cx_hwctrl_on = a725_read32(r->gpucc, A725_GPUCC_CX_HWCTRL);
+		return ETIMEDOUT;
+	}
+	value = a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+	if (!(value & A725_GDSC_RETAIN_FF)) {
+		a725_write32(r->gpucc, A725_GPUCC_CX_GDSCR,
+		    value | A725_GDSC_RETAIN_FF);
+	}
+	result->cx_gdscr_on = a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+	result->cx_hwctrl_on = a725_read32(r->gpucc, A725_GPUCC_CX_HWCTRL);
+	return 0;
+}
+
+static void
+a725_cx_rollback(const struct marble_a725_resources *r,
+    struct a725_power_results *result)
+{
+	uint32_t value = a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+	boolean_t off;
+	a725_write32(r->gpucc, A725_GPUCC_CX_GDSCR,
+	    value | A725_GDSC_SW_COLLAPSE);
+	(void)a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+	delay(101); /* Cape explicitly disables status checking on collapse. */
+	/* Read-only evidence beyond the downstream minimum; never retry collapse. */
+	off = a725_poll32(r->gpucc, A725_GPUCC_CX_HWCTRL,
+	    A725_GDSC_PWR_ON, 0, 500);
+	a725_write32(r->gpucc, A725_GPUCC_CX_GDSCR, result->cx_gdscr_before);
+	result->cx_gdscr_after = a725_read32(r->gpucc, A725_GPUCC_CX_GDSCR);
+	result->cx_hwctrl_after = a725_read32(r->gpucc, A725_GPUCC_CX_HWCTRL);
+	result->cx_rollback_error = result->cx_gdscr_after !=
+	    result->cx_gdscr_before ? EIO : off ? 0 : ETIMEDOUT;
+	result->cx_rollback = result->cx_rollback_error == ETIMEDOUT ?
+	    A725_TIMEOUT : result->cx_rollback_error ? A725_FAILED :
+	    A725_ACKNOWLEDGED;
+}
