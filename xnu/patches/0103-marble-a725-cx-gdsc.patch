+static inline void
+a725_write32(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static boolean_t
+a725_poll32(vm_offset_t base, uint32_t offset, uint32_t mask,
+    uint32_t expected, unsigned timeout_us)
+{
+	for (unsigned elapsed = 0; elapsed < timeout_us; elapsed++) {
+		if ((a725_read32(base, offset) & mask) == expected) {
+			return TRUE;
+		}
+		delay(1);
+	}
+	return (a725_read32(base, offset) & mask) == expected;
+}
