+static const char *
+marble_fb_boolean(IORegistryEntry *entry, const char *key, bool *value)
+{
+	OSObject *object = entry->copyProperty(key);
+	OSBoolean *boolean = OSDynamicCast(OSBoolean, object);
+	*value = boolean != NULL && boolean->isTrue();
+	const char *text = object == NULL ? "absent" :
+	    (boolean == NULL ? "non-boolean" : (*value ? "true" : "false"));
+	OSSafeReleaseNULL(object);
+	return text;
+}
