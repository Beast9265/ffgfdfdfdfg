+static uint32_t
+marble_fb_u32(IORegistryEntry *entry, const char *key)
+{
+	if (entry == NULL) {
+		return 0;
+	}
+	OSObject *object = entry->copyProperty(key);
+	OSData *data = OSDynamicCast(OSData, object);
+	OSNumber *number = OSDynamicCast(OSNumber, object);
+	uint32_t value = 0;
+	if (data != NULL && data->getLength() == sizeof(value)) {
+		memcpy(&value, data->getBytesNoCopy(), sizeof(value));
+	} else if (number != NULL) {
+		value = number->unsigned32BitValue();
+	}
+	OSSafeReleaseNULL(object);
+	return value;
+}
