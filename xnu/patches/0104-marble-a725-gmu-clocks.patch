+static void
+a725_show_clock_results(const struct a725_power_results *r)
+{
+	printf("\n\n============================================================\n");
+	printf("     MARBLE ADRENO 725 GMU CLOCK DIAGNOSTIC\n");
+	printf("     build: %s\n", A725_CLOCK_ID);
+	printf("------------------------------------------------------------\n");
+	printf(" MX VOTE       : %s\n", a725_pass_name(r->mx_vote));
+	printf(" CX VOTE       : %s\n", a725_pass_name(r->cx_vote));
+	printf(" AOP ACD       : %s\n", a725_pass_name(r->aop_acd));
+	printf(" CX ENABLE     : %s HWCTRL=%08x ON=%u\n",
+	    a725_pass_name(r->cx_enable), r->cx_hwctrl_on,
+	    !!(r->cx_hwctrl_on & A725_GDSC_PWR_ON));
+	for (unsigned i = 0; i < A725_CLOCK_COUNT; i++) {
+		if (a725_clocks[i].owner == A725_CLOCK_QDSS_OPTIONAL) {
+			printf(" %-13s : SKIPPED (QDSS-STM not enabled)\n",
+			    a725_clocks[i].name);
+		} else {
+			printf(" %-13s : %s CBCR=%08x%s\n", a725_clocks[i].name,
+			    a725_pass_name(r->clocks[i]), r->clock_after[i],
+			    a725_clocks[i].owner == A725_CLOCK_AON_INHERITED ?
+			    " inherited-AON" : "");
+		}
+	}
+	printf(" CLOCK CLEANUP : %s error=%d\n",
+	    a725_pass_name(r->clock_cleanup), r->clock_cleanup_error);
+	printf(" CX ROLLBACK   : %s HWCTRL=%08x\n",
+	    a725_pass_name(r->cx_rollback), r->cx_hwctrl_after);
+	printf(" RPMh RELEASE  : CX=%s MX=%s\n",
+	    a725_pass_name(r->cx_release), a725_pass_name(r->mx_release));
+	printf("------------------------------------------------------------\n");
+	printf(" CLOCK TRANSITIONS ONLY; GMU/GX/GPU EXECUTION NOT ATTEMPTED\n");
+	printf(" Continuing normal iOS startup in about 10 seconds.\n");
+	printf("============================================================\n");
+	delay(10000000);
+}
