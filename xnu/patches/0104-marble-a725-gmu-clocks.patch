+static vm_offset_t
+a725_clock_base(const struct marble_a725_resources *r,
+    const struct a725_clock_spec *clock)
+{
+	return clock->gpucc ? r->gpucc : r->gcc;
+}
+
+static boolean_t
+a725_clock_on(uint32_t value, enum a725_clock_halt halt)
+{
+	if (!(value & 1u)) {
+		return FALSE;
+	}
+	if (halt == A725_CLOCK_HALT) {
+		return !(value & A725_BRANCH_CLK_OFF);
+	}
+	if (halt == A725_CLOCK_HALT_VOTED) {
+		return !(value & A725_BRANCH_CLK_OFF) ||
+		    (value & (A725_BRANCH_CLK_OFF | A725_BRANCH_NOC_MASK)) ==
+		    A725_BRANCH_NOC_ON;
+	}
+	/* Qualcomm uses a fixed 10 us delay or deliberately skips status. */
+	return TRUE;
+}
+
+static boolean_t
+a725_clock_poll_on(vm_offset_t base, const struct a725_clock_spec *clock)
+{
+	if (clock->halt == A725_CLOCK_HALT_DELAY) {
+		delay(10);
+		return a725_clock_on(a725_read32(base, clock->offset), clock->halt);
+	}
+	if (clock->halt == A725_CLOCK_HALT_SKIP) {
+		return a725_clock_on(a725_read32(base, clock->offset), clock->halt);
+	}
+	for (unsigned elapsed = 0; elapsed < 200; elapsed++) {
+		if (a725_clock_on(a725_read32(base, clock->offset), clock->halt)) {
+			return TRUE;
+		}
+		delay(1);
+	}
+	return a725_clock_on(a725_read32(base, clock->offset), clock->halt);
+}
+
+static boolean_t
+a725_rcg_value(uint32_t value, const uint32_t *allowed, unsigned count)
+{
+	const uint32_t mask = (1u << 20) | (7u << 8) | 0x1fu;
+	for (unsigned i = 0; i < count; i++) {
+		if ((value & mask) == allowed[i]) {
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
+
+/*
+ * Validate the three source roots which feed the six normal Gen7 GMU clocks.
+ * This diagnostic does not reprogram an RCG: clock framework rate changes
+ * require parent/refcount state which XNU does not own yet.
+ */
+static boolean_t
+a725_validate_clock_roots(const struct marble_a725_resources *r)
+{
+	static const uint32_t gmu[] = { 0x100001, 0x100602, 0x100303 };
+	static const uint32_t hub[] = { 0x100603, 0x100504, 0x100503 };
+	static const uint32_t xo[] = { 0x100001 };
+	uint32_t gmu_cmd = a725_read32(r->gpucc, 0x9318);
+	uint32_t hub_cmd = a725_read32(r->gpucc, 0x93ec);
+	uint32_t xo_cmd = a725_read32(r->gpucc, 0x9010);
+	uint32_t gmu_cfg = a725_read32(r->gpucc, 0x931c);
+	uint32_t hub_cfg = a725_read32(r->gpucc, 0x93f0);
+	uint32_t xo_cfg = a725_read32(r->gpucc, 0x9014);
+	boolean_t valid = !(gmu_cmd & 1u) && !(hub_cmd & 1u) && !(xo_cmd & 1u) &&
+	    a725_rcg_value(gmu_cfg, gmu, sizeof(gmu) / sizeof(gmu[0])) &&
+	    a725_rcg_value(hub_cfg, hub, sizeof(hub) / sizeof(hub[0])) &&
+	    a725_rcg_value(xo_cfg, xo, sizeof(xo) / sizeof(xo[0]));
+	printf("MARBLE GPU: clock roots gmu=%08x/%08x hub=%08x/%08x xo=%08x/%08x valid=%u\n",
+	    gmu_cmd, gmu_cfg, hub_cmd, hub_cfg, xo_cmd, xo_cfg, valid);
+	return valid;
+}
+
+static boolean_t
+a725_enable_gmu_clocks(const struct marble_a725_resources *r,
+    struct a725_power_results *result)
+{
+	if (!a725_validate_clock_roots(r)) {
+		result->clock_error = EINVAL;
+		return FALSE;
+	}
+	for (unsigned i = 0; i < A725_CLOCK_COUNT; i++) {
+		const struct a725_clock_spec *clock = &a725_clocks[i];
+		vm_offset_t base;
+		uint32_t value;
+
+		if (clock->owner == A725_CLOCK_QDSS_OPTIONAL) {
+			/* KGSL removes apb_pclk unless CONFIG_QCOM_KGSL_QDSS_STM. */
+			result->clocks[i] = A725_NOT_ATTEMPTED;
+			continue;
+		}
+		base = a725_clock_base(r, clock);
+		value = a725_read32(base, clock->offset);
+		result->clock_before[i] = value;
+		if (clock->owner == A725_CLOCK_AON_INHERITED) {
+			if (!a725_clock_poll_on(base, clock)) {
+				result->clocks[i] = A725_FAILED;
+				result->clock_error = EBUSY;
+				printf("MARBLE GPU: clock=%s result=FAILED reason=AON_NOT_INHERITED cbcr=%08x\n",
+				    clock->name, value);
+				return FALSE;
+			}
+			result->clocks[i] = A725_ACKNOWLEDGED;
+			result->clock_after[i] = a725_read32(base, clock->offset);
+			continue;
+		}
+		if (!a725_clock_on(value, clock->halt)) {
+			result->clock_touched[i] = TRUE;
+			a725_write32(base, clock->offset, value | 1u);
+			if (!a725_clock_poll_on(base, clock)) {
+				result->clocks[i] = A725_TIMEOUT;
+				result->clock_error = ETIMEDOUT;
+				result->clock_after[i] = a725_read32(base, clock->offset);
+				return FALSE;
+			}
+		}
+		result->clock_after[i] = a725_read32(base, clock->offset);
+		result->clocks[i] = A725_ACKNOWLEDGED;
+		printf("MARBLE GPU: clock=%s result=ACKNOWLEDGED inherited=%u cbcr=%08x\n",
+		    clock->name, !result->clock_touched[i], result->clock_after[i]);
+	}
+	return TRUE;
+}
+
+static void
+a725_cleanup_gmu_clocks(const struct marble_a725_resources *r,
+    struct a725_power_results *result)
+{
+	result->clock_cleanup = A725_ACKNOWLEDGED;
+	for (int i = A725_CLOCK_COUNT - 1; i >= 0; i--) {
+		const struct a725_clock_spec *clock = &a725_clocks[i];
+		vm_offset_t base;
+		if (!result->clock_touched[i]) {
+			continue;
+		}
+		base = a725_clock_base(r, clock);
+		uint32_t value = a725_read32(base, clock->offset);
+		value = (value & ~1u) | (result->clock_before[i] & 1u);
+		a725_write32(base, clock->offset, value);
+		if ((a725_read32(base, clock->offset) & 1u) !=
+		    (result->clock_before[i] & 1u)) {
+			result->clock_cleanup = A725_FAILED;
+			result->clock_cleanup_error = EIO;
+		}
+		if (clock->halt == A725_CLOCK_HALT_DELAY ||
+		    clock->halt == A725_CLOCK_HALT_VOTED) {
+			delay(10);
+		}
+	}
+}
