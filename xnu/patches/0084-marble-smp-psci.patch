+boolean_t
+marble_cpu_signal_is_enabled(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		return FALSE;
+	}
+	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
