+/*
+ * One pass: read the event FIFO (one event, then the rest if queued),
+ * fold coordinate events into a final per-finger mask like the Goodix/
+ * Focaltech paths, and report once. Non-coordinate events (status,
+ * gesture, vendor) are read to drain the FIFO but otherwise ignored:
+ * no AOD/gesture support is implemented here.
+ */
+static int
+touch_st_fts(void)
+{
+	uint8_t data[(STFTS_FIFO_MAX + 1u) * STFTS_EVENT_SIZE];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0, touched = 0;
+
+	int err = touch_read(STFTS_I2C_ADDR, STFTS_CMD_READ_ONE, false,
+	    data, STFTS_EVENT_SIZE);
+	if (err) {
+		return err;
+	}
+	unsigned left = data[7] & 0x1fu;
+	if (left > STFTS_FIFO_MAX) {
+		return EIO; /* implausible queue depth: untrusted byte */
+	}
+	if (left) {
+		err = touch_read(STFTS_I2C_ADDR, STFTS_CMD_READ_ALL, false,
+		    data + STFTS_EVENT_SIZE, STFTS_EVENT_SIZE * left);
+		if (err) {
+			return err;
+		}
+	}
+	mask = st.active;
+	for (unsigned ev = 0; ev <= left; ++ev) {
+		const uint8_t *p = data + ev * STFTS_EVENT_SIZE;
+		unsigned eid = p[0] & 3u;
+		if (eid != STFTS_EVT_COORDINATE) {
+			continue;
+		}
+		unsigned tid = (p[0] >> 2) & 0xfu;
+		unsigned action = (p[0] >> 6) & 3u; /* 0 none,1 press,2 move,3 release */
+		if (tid >= TOUCH_MAX) {
+			return EIO;
+		}
+		if (action == 3u) {
+			mask &= ~(1u << tid);
+			continue;
+		}
+		if (action != 1u && action != 2u) {
+			continue; /* "none": no state change */
+		}
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] & 0xfu);
+		unsigned py = ((unsigned)p[2] << 4) | ((p[3] >> 4) & 0xfu);
+		if (px > 1079u || py > 2399u) {
+			return EIO;
+		}
+		/* st,x-flip / st,y-flip in the board's overlay: the IC's native
+		 * axes are mirrored against the panel a71fb presents. */
+		x[tid] = (int)(1079u - px);
+		y[tid] = (int)(2399u - py);
+		mask |= 1u << tid;
+		touched |= 1u << tid;
 	}
+	/* Carry forward last-known coordinates for ids not touched this pass
+	 * (a release-only or status-only batch), as touch_report expects. */
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		if ((mask & (1u << id)) && !(touched & (1u << id))) {
+			x[id] = st.x[id];
+			y[id] = st.y[id];
+		}
+	}
 	touch_report(mask, x, y);
 	return 0;
 }
