+#if defined(MARBLE)
+/* Kernel-private scheduling state used by the bounded opt-in SMP sampler. */
+int
+marble_cpu_busy(int cpu)
+{
+	processor_t p;
+
+	if (cpu < 0 || cpu >= MAX_SCHED_CPUS) {
+		return -1;
+	}
+	p = processor_array[cpu];
+	if (p == NULL) {
+		return -1;
+	}
+	return p->active_thread != NULL && p->active_thread != p->idle_thread;
+}
+
+uint64_t
+marble_cpu_tid(int cpu)
+{
+	processor_t p;
+
+	if (cpu < 0 || cpu >= MAX_SCHED_CPUS) {
+		return 0;
+	}
+	p = processor_array[cpu];
+	if (p == NULL || p->active_thread == NULL || p->active_thread == p->idle_thread) {
+		return 0;
+	}
+	return thread_tid(p->active_thread);
+}
+#endif /* MARBLE */
