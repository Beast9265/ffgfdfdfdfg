diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 0853181..02d14ad 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -72,11 +72,12 @@ extern void sweet_usb_probe(void);
 
 #ifdef ARM64_BOARD_CONFIG_MARBLE
 /*
- * SM8475 EPSS CPU frequency hardware. Linux describes three 4 KiB domains:
+ * SM7475 EPSS CPU frequency hardware. Linux describes three 4 KiB domains:
  *   CPU0-3  0x17d91000
  *   CPU4-6  0x17d92000
  *   CPU7    0x17d93000
- * This diagnostic is deliberately read-only.  Enable with marblecpufreq=1.
+ * marblecpufreq=1 is deliberately read-only.  marblecpufreq=2 permits one
+ * conservative domain0 vote after the LUT and hardware state validate.
  */
 #define MARBLE_EPSS_ENABLE       0x000u
 #define MARBLE_EPSS_DOMAIN_STATE 0x020u
@@ -105,10 +106,12 @@ static void
 marble_cpufreq_probe(void)
 {
 	uint32_t on = 0;
+	uint32_t cap_mhz = 0;
 	static const vm_offset_t pa[3] = { 0x17d91000u, 0x17d92000u, 0x17d93000u };
 
 	PE_parse_boot_argn("marblecpufreq", &on, sizeof(on));
-	if (on != 1) {
+	PE_parse_boot_argn("marblecpucap", &cap_mhz, sizeof(cap_mhz));
+	if (on != 1 && on != 2) {
 		return;
 	}
 
@@ -140,6 +143,10 @@ marble_cpufreq_probe(void)
 		    d, enable, state, dcvs, perf, current_raw, current_mhz);
 
 		uint32_t prev_mhz = UINT32_MAX;
+		uint32_t rows = 0;
+		uint32_t best_row = UINT32_MAX;
+		uint32_t best_mhz = 0;
+		boolean_t lut_sane = TRUE;
 		for (uint32_t i = 0; i < MARBLE_EPSS_LUT_MAX; i++) {
 			uint32_t raw = marble_epss_read(base, MARBLE_EPSS_FREQ_LUT + i * 4);
 			uint32_t volt = marble_epss_read(base, MARBLE_EPSS_VOLT_LUT + i * 4);
@@ -152,8 +159,47 @@ marble_cpufreq_probe(void)
 			if (i > 0 && mhz == prev_mhz) {
 				break;
 			}
+			if (mhz == 0 || (i > 0 && mhz < prev_mhz)) {
+				lut_sane = FALSE;
+			}
+			rows = i + 1;
+			if (cores != 1 && (!cap_mhz || mhz <= cap_mhz) && mhz >= best_mhz) {
+				best_row = i;
+				best_mhz = mhz;
+			}
 			prev_mhz = mhz;
 		}
+
+		if (on == 2 && d == 0) {
+			/* Linux qcom-cpufreq-hw uses ENABLE bit0 and DCVS_CTRL bit0. */
+			if (!(enable & 1U) || rows == 0 || !lut_sane || perf >= rows ||
+			    best_row == UINT32_MAX || current_raw == 0 || (state & 0xffU) == 0) {
+				printf("MARBLE CPUFREQ: domain0 vote REFUSED enable=0x%x state=0x%x perf=%u rows=%u sane=%u best=%u\n",
+				    enable, state, perf, rows, lut_sane, best_row);
+				continue;
+			}
+			uint32_t selected_raw = marble_epss_read(base,
+			    MARBLE_EPSS_FREQ_LUT + best_row * 4);
+			if (((selected_raw >> 16) & 7U) == 1 ||
+			    marble_epss_mhz(selected_raw) != best_mhz) {
+				printf("MARBLE CPUFREQ: domain0 vote REFUSED selected LUT changed\n");
+				continue;
+			}
+			printf("MARBLE CPUFREQ: domain0 vote previous=%u new=%u expected=%u MHz per_core=%u cap=%u\n",
+			    perf, best_row, best_mhz, dcvs & 1U, cap_mhz);
+			*((volatile uint32_t *)(base + MARBLE_EPSS_PERF_STATE)) = best_row;
+			if (dcvs & 1U) {
+				/* Domain0 contains exactly the enabled A510 CPUs 0-3. */
+				for (uint32_t cpu = 1; cpu < 4; cpu++) {
+					*((volatile uint32_t *)(base + MARBLE_EPSS_PERF_STATE + cpu * 4)) = best_row;
+				}
+			}
+			__builtin_arm_dsb(DSB_SY);
+			uint32_t readback = marble_epss_read(base, MARBLE_EPSS_PERF_STATE);
+			printf("MARBLE CPUFREQ: domain0 vote readback=%u expected_row=%u expected=%u MHz%s\n",
+			    readback, best_row, best_mhz,
+			    readback == best_row ? "" : " MISMATCH");
+		}
 	}
 }
 #endif /* ARM64_BOARD_CONFIG_MARBLE */
