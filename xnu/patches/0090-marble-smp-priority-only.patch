diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -489,124 +489,5 @@
 Lmarble_secondary_el1:
-	/*
-	 * HelioDarwin x676c and ios-topaz topaz prepare secondary Qualcomm
-	 * redistributors before XNU because otherwise SGIs and the vtimer remain
-	 * ineligible after initCPU. Pixel3's p1-probe independently uses the same
-	 * Group-1/priority/enable sequence. MARBLE's MMU-on write to the protected
-	 * SGI frame aborted; perform the physical MMIO while translation is off.
-	 *
-	 * CPU1 (MPIDR 0x100) is physically known-good and receives no redistributor
-	 * or CPU-interface change. Restrict this first correction to CPU2/CPU3. Scan
-	 * GICR_TYPER rather than assuming frame order; SM8450 DT proves
-	 * 17180000/200000 and a 40000 redistributor stride.
-	 */
-	mrs		x1, MPIDR_EL1
-	and		x1, x1, #0xffff
-	cmp		x1, #0x200
-	b.eq	Lmarble_secondary_gic_prepare
-	cmp		x1, #0x300
-	b.ne	Lmarble_secondary_gic_done
-Lmarble_secondary_gic_prepare:
-	/* Match reset_vector: install a valid EL1 vector before any MMIO load. */
-	adrp	x3, EXT(LowExceptionVectorBase)@page
-	add		x3, x3, EXT(LowExceptionVectorBase)@pageoff
-	msr		VBAR_EL1, x3
-	isb
-	lsr		x2, x1, #8			// logical A510 index: 2 or 3
-	adrp	x10, EXT(marble_secondary_gic_diag)@page
-	add		x10, x10, EXT(marble_secondary_gic_diag)@pageoff
-	add		x10, x10, x2, lsl #6		// 16 u32, private cache line
-	mov		w11, #0x8000			// attempted; miss until matched
-	str		w11, [x10]
-	MOV64	x6, 0x17180000
-	mov		w5, #8
-Lmarble_secondary_gic_scan:
-	ldr		x7, [x6, #8]			// GICR_TYPER
-	lsr		x8, x7, #32
-	and		x8, x8, #0xffff
-	cmp		x8, x1
-	b.eq	Lmarble_secondary_gic_found
-	add		x6, x6, #0x40, lsl #12	// SM8450 stride 0x40000
-	subs	w5, w5, #1
-	b.ne	Lmarble_secondary_gic_scan
-	b		Lmarble_secondary_gic_store_status
-Lmarble_secondary_gic_found:
-	mov		w11, #1				// frame found / setup attempted
-	str		w6, [x10, #4]
-	str		w8, [x10, #8]
-	ldr		w3, [x6, #0x14]		// GICR_WAKER before
-	str		w3, [x10, #12]
-	ldr		w4, [x6]			// GICR_CTLR before
-	str		w4, [x10, #20]
-	mov		x9, #0x10000
-	add		x9, x6, x9			// SGI/PPI frame
-	ldr		w4, [x9, #0x80]		// GICR_IGROUPR0 before
-	str		w4, [x10, #24]
-	ldr		w4, [x9, #0xd00]		// GICR_IGRPMODR0 before
-	str		w4, [x10, #28]
-	ldr		w4, [x9, #0x400]		// priorities INTID0..3 before
-	str		w4, [x10, #32]
-	ldrb	w4, [x9, #0x41b]		// MARBLE virtual timer INTID27
-	str		w4, [x10, #60]
-	ldr		w4, [x9, #0x100]		// GICR_ISENABLER0 before
-	str		w4, [x10, #36]
-	// Wake this redistributor. A bounded timeout is recorded, never hidden.
-	tbz		w3, #1, Lmarble_secondary_gic_wake_begin
-	bic		w3, w3, #2
-	str		w3, [x6, #0x14]
-Lmarble_secondary_gic_wake_begin:
-	mov		w5, #0x40000
-Lmarble_secondary_gic_wake_wait:
-	ldr		w3, [x6, #0x14]
-	tbz		w3, #2, Lmarble_secondary_gic_awake
-	subs	w5, w5, #1
-	b.ne	Lmarble_secondary_gic_wake_wait
-	orr		w11, w11, #2			// ChildrenAsleep timeout
-	str		w3, [x10, #16]
-	b		Lmarble_secondary_gic_store_status
-Lmarble_secondary_gic_awake:
-	str		w3, [x10, #16]		// WAKER after bounded wake
-	// Non-secure Group 1, priority 0xa0, SGI1 + MARBLE vtimer PPI27.
-	mov		w4, #0xffffffff
-	str		w4, [x9, #0x80]		// GICR_IGROUPR0
-	mov		w4, #0xa0
-	mov		w5, #32
-	add		x7, x9, #0x400
-Lmarble_secondary_gic_priority:
-	strb	w4, [x7], #1
-	subs	w5, w5, #1
-	b.ne	Lmarble_secondary_gic_priority
-	mov		w4, #2
-	orr		w4, w4, #(1 << 27)
-	str		w4, [x9, #0x100]		// GICR_ISENABLER0
-	dsb		sy
-	// GICR_CTLR.RWP is bit3. Bound the wait and preserve timeout evidence.
-	mov		w5, #0x40000
-Lmarble_secondary_gic_rwp_wait:
-	ldr		w4, [x6]
-	tbz		w4, #3, Lmarble_secondary_gic_rwp_done
-	subs	w5, w5, #1
-	b.ne	Lmarble_secondary_gic_rwp_wait
-	orr		w11, w11, #4
-Lmarble_secondary_gic_rwp_done:
-	ldr		w4, [x9, #0x80]
-	str		w4, [x10, #40]
-	ldr		w4, [x9, #0xd00]
-	str		w4, [x10, #44]
-	ldr		w4, [x9, #0x400]
-	str		w4, [x10, #48]
-	ldrb	w4, [x9, #0x41b]
-	ldr		w5, [x10, #60]
-	orr		w5, w5, w4, lsl #8
-	str		w5, [x10, #60]		// timer before low8, after next8
-	ldr		w4, [x9, #0x100]
-	str		w4, [x10, #52]
-	ldr		w4, [x6]
-	str		w4, [x10, #56]
-Lmarble_secondary_gic_store_status:
-	str		w11, [x10]
-	dsb		sy
-Lmarble_secondary_gic_done:
-	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
-	msr		SPSel, #1
-	b		EXT(LowResetVectorBase)
+	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
+	msr		SPSel, #1
+	b		EXT(LowResetVectorBase)
 #endif /* MARBLE */
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -250,4 +250,15 @@
 #if defined(MARBLE)
-	/* Firmware owns group routing; MMU-on write at PA 0x17190080 aborts. */
-	kprintf("MARBLE GIC: skip GICR_IGROUPR0\n");
+	/*
+	 * 0090 isolates the remaining priority hypothesis.  Touch only SGI1 and
+	 * the architected virtual timer PPI27 after this CPU's redistributor is
+	 * awake on the failing logical CPU2; never write IGROUPR0/IGRPMODR0 and
+	 * leave the known-good CPU1 byte-for-byte at its inherited priorities.
+	 */
+	if (ml_get_cpu_number_local() == 2) {
+		*((volatile uint8_t *)(gicr_pe_base + GICR_IPRIORITYR0 + QUALCOMM_IPI_SGI)) = 0xA0;
+		*((volatile uint8_t *)(gicr_pe_base + GICR_IPRIORITYR0 + sweet_vtimer_intid)) = 0xA0;
+		__builtin_arm_dsb(DSB_SY);
+	}
+	/* Firmware owns group routing; MMU-on write at PA 0x17190080 aborts. */
+	kprintf("MARBLE GIC: skip GICR_IGROUPR0\n");
 #else
