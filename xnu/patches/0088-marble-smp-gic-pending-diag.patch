 	    (((mpidr >> 16) & 0xff) << 32) |
 	    (((mpidr >> 8) & 0xff) << 16) |
 	    ((uint64_t)MARBLE_IPI_SGI << 24) | (1ULL << aff0);
+	kprintf("MARBLE SMPDBG: SGI send sender=0x%llx target_cpu=%u target=0x%llx SGI1R=0x%llx\n",
