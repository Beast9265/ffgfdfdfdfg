diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 7741c6d..b2fcf4b 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -27,6 +27,137 @@ static vm_offset_t gicr_base;
 static vm_offset_t gicr_size;
 
 #if defined(MARBLE)
+#define gicd_read32(offset) (*((volatile uint32_t *)(gicd_base + (offset))))
+#define gicd_write32(offset, data) \
+	(*((volatile uint32_t *)(gicd_base + (offset))) = (data))
+#define MARBLE_GICD_TYPER       0x0004u
+#define MARBLE_GICD_IGROUPR     0x0080u
+#define MARBLE_GICD_ISENABLER   0x0100u
+#define MARBLE_GICD_ICENABLER   0x0180u
+#define MARBLE_GICD_ISPENDR     0x0200u
+#define MARBLE_GICD_ICPENDR     0x0280u
+#define MARBLE_GICD_ISACTIVER   0x0300u
+#define MARBLE_GICD_IPRIORITYR  0x0400u
+#define MARBLE_GICD_ICFGR       0x0c00u
+#define MARBLE_GICD_IROUTER     0x6000u
+
+static uint32_t marble_spi_ipi_mode;
+static uint32_t marble_spi_ipi_base;
+static uint32_t marble_gic_intids;
+volatile uint64_t marble_spi_ipi_sent[MARBLE_SMP_MAX_CPUS];
+volatile uint64_t marble_spi_ipi_handled[MARBLE_SMP_MAX_CPUS];
+
+static void
+marble_gicd_wait(void)
+{
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+}
+
+boolean_t
+marble_spi_ipi_enabled(void)
+{
+	return marble_spi_ipi_mode != 0;
+}
+
+boolean_t
+marble_spi_ipi_is_intid(uint32_t intid)
+{
+	return marble_spi_ipi_mode && intid >= marble_spi_ipi_base &&
+	    intid < marble_spi_ipi_base + MARBLE_SMP_MAX_CPUS;
+}
+
+void
+marble_spi_ipi_handled_one(uint32_t intid)
+{
+	uint32_t cpu = intid - marble_spi_ipi_base;
+	if (cpu < MARBLE_SMP_MAX_CPUS) {
+		uint64_t handled = __atomic_add_fetch(&marble_spi_ipi_handled[cpu], 1,
+		    __ATOMIC_RELAXED);
+		uint32_t word = (intid / 32) * 4;
+		uint32_t bit = 1U << (intid % 32);
+		kprintf("MARBLE SPI IPI: handled cpu=%u intid=%u handled=%llu sent=%llu pend=%u active=%u HPPIR1=%llu\n",
+		    cpu, intid, handled, marble_spi_ipi_sent[cpu],
+		    !!(gicd_read32(MARBLE_GICD_ISPENDR + word) & bit),
+		    !!(gicd_read32(MARBLE_GICD_ISACTIVER + word) & bit),
+		    __builtin_arm_rsr64("ICC_HPPIR1_EL1") & 0xffffffULL);
+	}
+}
+
+void
+marble_spi_ipi_send(unsigned int cpu)
+{
+	if (!marble_spi_ipi_mode || cpu >= MARBLE_SMP_MAX_CPUS) {
+		panic("MARBLE SPI IPI: invalid send cpu=%u mode=%u", cpu,
+		    marble_spi_ipi_mode);
+	}
+	uint32_t intid = marble_spi_ipi_base + cpu;
+	uint32_t word = (intid / 32) * 4;
+	uint32_t bit = 1U << (intid % 32);
+	__atomic_add_fetch(&marble_spi_ipi_sent[cpu], 1, __ATOMIC_RELAXED);
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(MARBLE_GICD_ISPENDR + word, bit);
+	__builtin_arm_dsb(DSB_SY);
+	kprintf("MARBLE SPI IPI: send cpu=%u intid=%u sent=%llu pend=%u active=%u HPPIR1=%llu\n",
+	    cpu, intid, marble_spi_ipi_sent[cpu],
+	    !!(gicd_read32(MARBLE_GICD_ISPENDR + word) & bit),
+	    !!(gicd_read32(MARBLE_GICD_ISACTIVER + word) & bit),
+	    __builtin_arm_rsr64("ICC_HPPIR1_EL1") & 0xffffffULL);
+}
+
+static void
+marble_spi_ipi_configure(unsigned int cpu, uint64_t mpidr)
+{
+	if (!marble_spi_ipi_mode || cpu >= MARBLE_SMP_MAX_CPUS) {
+		return;
+	}
+	uint32_t intid = marble_spi_ipi_base + cpu;
+	uint32_t word = (intid / 32) * 4;
+	uint32_t bit = 1U << (intid % 32);
+	uint32_t cfg_off = MARBLE_GICD_ICFGR + (intid / 16) * 4;
+	uint32_t cfg_shift = (intid % 16) * 2;
+	uint64_t affinity = mpidr & 0xff00ffffffULL;
+	if ((gicd_read32(MARBLE_GICD_ISENABLER + word) & bit) ||
+	    (gicd_read32(MARBLE_GICD_ISPENDR + word) & bit) ||
+	    (gicd_read32(MARBLE_GICD_ISACTIVER + word) & bit)) {
+		panic("MARBLE SPI IPI: intid %u is already enabled/pending/active", intid);
+	}
+
+	/* Only the selected SPI's architectural distributor fields are touched. */
+	gicd_write32(MARBLE_GICD_ICENABLER + word, bit);
+	marble_gicd_wait();
+	gicd_write32(MARBLE_GICD_IGROUPR + word,
+	    gicd_read32(MARBLE_GICD_IGROUPR + word) | bit);
+	*((volatile uint8_t *)(gicd_base + MARBLE_GICD_IPRIORITYR + intid)) = 0xa0;
+	uint32_t cfg = gicd_read32(cfg_off);
+	cfg = (cfg & ~(3U << cfg_shift)) | (2U << cfg_shift); /* edge */
+	gicd_write32(cfg_off, cfg);
+	*((volatile uint64_t *)(gicd_base + MARBLE_GICD_IROUTER + 8ULL * intid)) = affinity;
+	gicd_write32(MARBLE_GICD_ICPENDR + word, bit);
+	__builtin_arm_dsb(DSB_SY);
+	gicd_write32(MARBLE_GICD_ISENABLER + word, bit);
+	marble_gicd_wait();
+	__builtin_arm_dsb(DSB_SY);
+
+	uint64_t route = *((volatile uint64_t *)(gicd_base +
+	    MARBLE_GICD_IROUTER + 8ULL * intid));
+	uint32_t group = !!(gicd_read32(MARBLE_GICD_IGROUPR + word) & bit);
+	uint32_t enabled = !!(gicd_read32(MARBLE_GICD_ISENABLER + word) & bit);
+	uint32_t edge = (gicd_read32(cfg_off) >> (cfg_shift + 1)) & 1U;
+	uint32_t priority = *((volatile uint8_t *)(gicd_base +
+	    MARBLE_GICD_IPRIORITYR + intid));
+	kprintf("MARBLE SPI IPI: cpu=%u intid=%u mpidr=0x%llx route=0x%llx group=%u edge=%u pri=0x%02x en=%u pend=%u active=%u\n",
+	    cpu, intid, mpidr, route, group, edge, priority, enabled,
+	    !!(gicd_read32(MARBLE_GICD_ISPENDR + word) & bit),
+	    !!(gicd_read32(MARBLE_GICD_ISACTIVER + word) & bit));
+	if (!group || !enabled || !edge || priority != 0xa0 || route != affinity) {
+		gicd_write32(MARBLE_GICD_ICENABLER + word, bit);
+		marble_gicd_wait();
+		panic("MARBLE SPI IPI: intid %u distributor readback mismatch", intid);
+	}
+}
