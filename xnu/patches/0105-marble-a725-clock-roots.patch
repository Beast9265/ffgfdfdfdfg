+/*
+ * The matching GCC driver exposes GPLL0 as a fixed Lucid-OLE PLL (Cape fixup) and the
+ * GPU's divided parent as vote bit 16.  Do not configure or vote the global
+ * PLL here: other boot firmware owns it.  Require its RUN/output/lock state,
+ * verify 600 MHz / 2 from L/ALPHA/USER_CTL (19.2 MHz XO),
+ * then acquire only the reversible GPU divider vote.
+ */
+static boolean_t
+a725_root_parent_acquire(const struct marble_a725_resources *r,
+    struct a725_power_results *result)
+{
+	result->gpll0_mode = a725_read32(r->gcc, A725_GPLL0_MODE);
+	result->gpll0_opmode = a725_read32(r->gcc, A725_GPLL0_OPMODE);
+	result->gpll0_l = a725_read32(r->gcc, A725_GPLL0_L);
+	result->gpll0_alpha = a725_read32(r->gcc, A725_GPLL0_ALPHA);
+	result->gpll0_user = a725_read32(r->gcc, A725_GPLL0_USER);
+	result->gpll0_vote = a725_read32(r->gcc, A725_GPLL0_VOTE);
+	result->parent_before = a725_read32(r->gcc, A725_GPU_GPLL0_VOTES);
+	if ((result->gpll0_mode & ((1u << 31) | 1u)) !=
+	    ((1u << 31) | 1u) || result->gpll0_opmode != 1u ||
+	    (result->gpll0_l & 0xffffu) != 31u ||
+	    (result->gpll0_alpha & 0xffffu) != 0x4000u ||
+	    ((result->gpll0_user >> 10) & 0xfu) != 1u) {
+		result->parent_source = A725_FAILED;
+		result->root_error = ENXIO;
+		return FALSE;
+	}
+	if (!(result->parent_before & A725_GPU_GPLL0_DIV)) {
+		result->parent_touched = TRUE;
+		a725_write32(r->gcc, A725_GPU_GPLL0_VOTES,
+		    result->parent_before | A725_GPU_GPLL0_DIV);
+		delay(10); /* gcc_gpu_gpll0_div_clk_src: BRANCH_HALT_DELAY */
+	}
+	result->parent_after = a725_read32(r->gcc, A725_GPU_GPLL0_VOTES);
+	result->parent_source = result->parent_after & A725_GPU_GPLL0_DIV ?
+	    A725_ACKNOWLEDGED : A725_FAILED;
+	if (result->parent_source != A725_ACKNOWLEDGED) {
+		result->root_error = EIO;
+		return FALSE;
+	}
+	return TRUE;
+}
+
+static boolean_t
+a725_root_update(vm_offset_t gpucc, uint32_t cmd)
+{
+	uint32_t value = a725_read32(gpucc, cmd);
+	a725_write32(gpucc, cmd, value | A725_RCG_UPDATE);
+	return a725_poll32(gpucc, cmd, A725_RCG_UPDATE, 0, 500);
+}
+
+static boolean_t
+a725_root_program_one(const struct marble_a725_resources *r,
+    struct a725_power_results *result, unsigned i)
+{
+	const struct a725_root_spec *root = &a725_roots[i];
+	uint32_t cmd = a725_read32(r->gpucc, root->cmd);
+	uint32_t cfg = a725_read32(r->gpucc, root->cmd + 4);
+	result->root_cmd_before[i] = cmd;
+	result->root_cfg_before[i] = cfg;
+	/* Never take over a pending transaction or an inherited force owner.
+	 * Only reset/CXO or the selected rate has a parent we can preserve. */
+	if ((cmd & (A725_RCG_UPDATE | A725_RCG_ROOT_EN)) ||
+	    ((cfg & A725_RCG_CFG_MASK) != 0 &&
+	    (cfg & A725_RCG_CFG_MASK) != 0x100001 &&
+	    (cfg & A725_RCG_CFG_MASK) != root->config)) {
+		result->root_cmd_live[i] = cmd;
+		result->root_cfg_live[i] = cfg;
+		result->roots[i] = A725_FAILED;
+		result->root_error = EBUSY;
+		/* An inherited owner/transaction may still consume these rails. */
+		result->root_uncertain = TRUE;
+		return FALSE;
+	}
+
+	/* Force the otherwise-unused root on exactly as clk-rcg2.c does. */
+	if (!(cmd & A725_RCG_ROOT_EN)) {
+		result->root_touched[i] = TRUE;
+		a725_write32(r->gpucc, root->cmd, cmd | A725_RCG_ROOT_EN);
+		if (!a725_poll32(r->gpucc, root->cmd,
+		    A725_RCG_ROOT_OFF | A725_RCG_ROOT_EN, A725_RCG_ROOT_EN, 500)) {
+			result->root_cmd_live[i] = a725_read32(r->gpucc, root->cmd);
+			result->root_cfg_live[i] = a725_read32(r->gpucc, root->cmd + 4);
+			result->roots[i] = A725_TIMEOUT;
+			result->root_error = ETIMEDOUT;
+			result->root_uncertain = TRUE;
+			return FALSE;
+		}
+	}
+	cfg = a725_read32(r->gpucc, root->cmd + 4);
+	a725_write32(r->gpucc, root->cmd + 4,
+	    (cfg & ~A725_RCG_CFG_MASK) | root->config);
+	result->root_touched[i] = TRUE;
+	result->root_configured[i] = TRUE;
+	if (!a725_root_update(r->gpucc, root->cmd)) {
+		result->root_cmd_live[i] = a725_read32(r->gpucc, root->cmd);
+		result->root_cfg_live[i] = a725_read32(r->gpucc, root->cmd + 4);
+		/* Completion is uncertain.  Do not issue another root transaction. */
+		result->roots[i] = A725_TIMEOUT;
+		result->root_error = ETIMEDOUT;
+		result->root_uncertain = TRUE;
+		return FALSE;
+	}
+	result->root_cmd_live[i] = a725_read32(r->gpucc, root->cmd);
+	result->root_cfg_live[i] = a725_read32(r->gpucc, root->cmd + 4);
+	if ((result->root_cfg_live[i] & A725_RCG_CFG_MASK) != root->config ||
+	    (result->root_cmd_live[i] & (A725_RCG_UPDATE | A725_RCG_ROOT_OFF |
+	    A725_RCG_ROOT_EN)) != A725_RCG_ROOT_EN) {
+		result->roots[i] = A725_FAILED;
+		result->root_error = EIO;
+		return FALSE;
+	}
+	result->roots[i] = A725_ACKNOWLEDGED;
+	return TRUE;
+}
+
+static void
+a725_root_cleanup(const struct marble_a725_resources *r,
+    struct a725_power_results *result)
+{
+	result->root_cleanup = A725_ACKNOWLEDGED;
+	if (result->root_uncertain) {
+		result->root_cleanup = A725_NOT_ATTEMPTED;
+		result->root_cleanup_error = EBUSY;
+		return;
+	}
+	for (int i = A725_ROOT_COUNT - 1; i >= 0; i--) {
+		const struct a725_root_spec *root = &a725_roots[i];
+		if (!result->root_touched[i]) {
+			continue;
+		}
+		if (result->root_configured[i]) {
+			uint32_t cfg = a725_read32(r->gpucc, root->cmd + 4);
+			a725_write32(r->gpucc, root->cmd + 4,
+			    (cfg & ~A725_RCG_CFG_MASK) |
+			    (result->root_cfg_before[i] & A725_RCG_CFG_MASK));
+			if (!a725_root_update(r->gpucc, root->cmd)) {
+				result->root_cleanup = A725_TIMEOUT;
+				result->root_cleanup_error = ETIMEDOUT;
+				result->root_uncertain = TRUE;
+				return;
+			}
+		}
+		uint32_t cmd = a725_read32(r->gpucc, root->cmd);
+		cmd = (cmd & ~A725_RCG_ROOT_EN) |
+		    (result->root_cmd_before[i] & A725_RCG_ROOT_EN);
+		a725_write32(r->gpucc, root->cmd, cmd);
+		result->root_cmd_after[i] = a725_read32(r->gpucc, root->cmd);
+		result->root_cfg_after[i] = a725_read32(r->gpucc, root->cmd + 4);
+		if ((result->root_cfg_after[i] & A725_RCG_CFG_MASK) !=
+		    (result->root_cfg_before[i] & A725_RCG_CFG_MASK) ||
+		    (result->root_cmd_after[i] & A725_RCG_ROOT_EN) !=
+		    (result->root_cmd_before[i] & A725_RCG_ROOT_EN)) {
+			result->root_cleanup = A725_FAILED;
+			result->root_cleanup_error = EIO;
+			return;
+		}
+	}
+	if (result->parent_touched) {
+		uint32_t value = a725_read32(r->gcc, A725_GPU_GPLL0_VOTES);
+		value = (value & ~A725_GPU_GPLL0_DIV) |
+		    (result->parent_before & A725_GPU_GPLL0_DIV);
+		a725_write32(r->gcc, A725_GPU_GPLL0_VOTES, value);
+		delay(10);
+		result->parent_after = a725_read32(r->gcc, A725_GPU_GPLL0_VOTES);
+		if ((result->parent_after & A725_GPU_GPLL0_DIV) !=
+		    (result->parent_before & A725_GPU_GPLL0_DIV)) {
+			result->root_cleanup = A725_FAILED;
+			result->root_cleanup_error = EIO;
+		}
+	}
+}
