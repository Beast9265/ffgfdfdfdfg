+/*
+ * Use the already initialized 2x sweet-fbcon console.  This deliberately
+ * creates no framebuffer mapping or display state of its own.  All release
+ * operations which are safe after acknowledged votes have completed before
+ * this function is entered.
+ */
+static void
+a725_show_power_results(const struct a725_power_results *r)
+{
+	printf("\n\n============================================================\n");
+	printf("          MARBLE ADRENO 725 RPMh DIAGNOSTIC\n");
+	printf("          build: %s\n", A725_VISUAL_ID);
+	printf("------------------------------------------------------------\n");
+	printf(" MX VOTE     : %-13s error=%d HLVL=%u VLVL=%u\n",
+	    a725_result_name(r->mx_vote), r->mx_vote_error, r->mx_hlvl, r->mx_vlvl);
+	printf(" CX VOTE     : %-13s error=%d HLVL=%u VLVL=%u\n",
+	    a725_result_name(r->cx_vote), r->cx_vote_error, r->cx_hlvl, r->cx_vlvl);
+	printf(" CX RELEASE  : %-13s error=%d\n",
+	    a725_result_name(r->cx_release), r->cx_release_error);
+	printf(" MX RELEASE  : %-13s error=%d\n",
+	    a725_result_name(r->mx_release), r->mx_release_error);
+	printf("------------------------------------------------------------\n");
+	printf(" ACK means RPMh command acknowledgement only.\n");
+	printf(" GPU POWER / GMU EXECUTION: NOT ATTEMPTED\n");
+	printf(" Continuing normal iOS startup in about 10 seconds.\n");
+	printf("============================================================\n");
+	delay(10000000);
+}
