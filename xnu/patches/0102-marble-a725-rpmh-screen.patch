+static const char *
+a725_result_name(enum a725_rpmh_result result)
+{
+	switch (result) {
+	case A725_ACKNOWLEDGED: return "ACKNOWLEDGED";
+	case A725_FAILED: return "FAILED";
+	case A725_TIMEOUT: return "TIMEOUT";
+	default: return "NOT ATTEMPTED";
+	}
+}
