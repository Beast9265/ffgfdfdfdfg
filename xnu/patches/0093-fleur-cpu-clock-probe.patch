+/*
+ * fleur: cycles per 2 ms of the generic timer, from the PMU cycle counter
+ * (PMCR_EL0.E on, .D off, PMCNTENSET_EL0.C): the clock this core runs at.
+ * Nothing in this kernel drives CPU DVFS, so it is whatever LK/MCUPM left.
+ */
+static unsigned
+sweet_cpu_mhz(void)
+{
+	uint64_t pmcr = __builtin_arm_rsr64("PMCR_EL0");
+	__builtin_arm_wsr64("PMCR_EL0", (pmcr | 1ULL) & ~8ULL);
+	__builtin_arm_wsr64("PMCNTENSET_EL0", 1ULL << 31);
+	__builtin_arm_isb(ISB_SY);
+	uint64_t span, t0 = mach_absolute_time();
+	nanoseconds_to_absolutetime(2000000ULL, &span);
+	uint64_t c0 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	while (mach_absolute_time() - t0 < span) {
+	}
+	uint64_t c1 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return ns ? (unsigned)((c1 - c0) * 1000ULL / ns) : 0;
+}
